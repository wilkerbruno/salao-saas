# Local (com `pnpm db:up`, ver infra/docker-compose.yml):
DATABASE_URL="mysql://salao:salao_dev@localhost:3306/salao_saas"

# Produção (MySQL do EasyPanel): use o HOSTNAME INTERNO do serviço de banco
# (algo como "salao-saas-mysql", visível no próprio EasyPanel), nunca o
# domínio público — assim o tráfego nunca sai da rede interna do EasyPanel.
# Veja docs/DEPLOY_EASYPANEL.md para o passo a passo completo.
# DATABASE_URL="mysql://app_salao:SENHA_FORTE_AQUI@salao-saas-mysql:3306/salao_saas"

# Gere um valor forte e único (nunca reaproveite entre ambientes):
# openssl rand -base64 48
JWT_SECRET="troque-isso-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="7d"
PORT=3000

# Opcional: se definidos, o container cria (ou atualiza a senha de) esse
# usuário SAAS_ADMIN sozinho ao subir — é assim que você acessa o painel do
# dono da plataforma pela primeira vez sem precisar de SSH/console pra criar
# esse registro na mão. Defina só em produção (no EasyPanel), com uma senha
# forte; pode remover depois do primeiro login se preferir.
# SAAS_ADMIN_EMAIL="voce@suaempresa.com"
# SAAS_ADMIN_SENHA="uma-senha-forte-aqui"

# Mercado Pago — cobrança recorrente da mensalidade dos salões assinantes
# do SaaS (ver AssinaturasService/MercadoPagoService). Pegue o Access Token em
# https://www.mercadopago.com.br/developers/panel > sua aplicação >
# Credenciais de produção (ou "de teste" pra testar com cartões de sandbox
# antes de ir ao ar). Sem isso definido, o botão "trocar de plano" no app da
# salão mostra um erro amigável em vez de travar o sistema.
MERCADOPAGO_ACCESS_TOKEN=""

# Chave secreta do webhook — NÃO é o Access Token. Pegue em: sua aplicação >
# Webhooks > Configurar notificações > "Assinatura secreta" (mostrar chave).
# Usada pra validar que uma notificação recebida em /webhooks/pagamento
# realmente veio do Mercado Pago. Opcional, mas fortemente recomendado em
# produção — sem isso o webhook processa qualquer POST sem checar a origem.
MERCADOPAGO_WEBHOOK_SECRET=""

# Pra onde o Mercado Pago manda o dono do salão de volta depois de
# autorizar a assinatura no checkout. Uma página simples de "pagamento
# confirmado" do seu painel web (ver apps/admin-web/src/app/pagamento-confirmado) —
# em produção, use a URL pública do admin-web (ex: https://painel.seusalao.com/pagamento-confirmado).
MERCADOPAGO_BACK_URL="http://localhost:3001/pagamento-confirmado"

# ===== E-mail (SMTP) — hoje só o código de "esqueci minha senha" =====
# Sem isso definido, o código fica só LOGADO no console da API (não é
# enviado de verdade) — útil pra testar em dev olhando o log, mas em produção
# configure um SMTP de verdade (ver AuthService.esqueciSenha/EmailService).
#
# Caminho mais rápido pra testar: Gmail. 1) ative a verificação em duas etapas
# na conta Google que vai enviar; 2) crie uma "Senha de app" em
# https://myaccount.google.com/apppasswords (procure por "App passwords" se o
# link mudar) — NÃO é a senha normal da conta; 3) use essa senha de 16
# caracteres abaixo em SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="seuemail@gmail.com"
SMTP_PASS=""
# Remetente mostrado pro usuário — o endereço "de" nem sempre pode ser
# diferente de SMTP_USER dependendo do provedor (no Gmail, geralmente precisa
# ser o mesmo e-mail autenticado). Formato '"Nome" <email>' é opcional.
SMTP_FROM='"Bella One" <seuemail@gmail.com>'

# ===== Mercado Pago — conta de CADA SALAO (marketplace/Connect) =====
# Diferente do MERCADOPAGO_ACCESS_TOKEN acima (que é a SUA conta, usada só
# pra cobrar a mensalidade do SaaS): estas credenciais são da SUA APLICAÇÃO
# Mercado Pago (não de uma conta específica) e servem pra cada salão
# conectar a PRÓPRIA conta — é assim que o pagamento do cliente final cai
# direto na conta do salão, não na sua.
#
# Onde pegar: https://www.mercadopago.com.br/developers/panel > sua aplicação
# > "Configurações avançadas" (nem toda aplicação tem OAuth habilitado por
# padrão — se não aparecer Client ID/Secret, pode ser preciso habilitar
# "Marketplace" nas configurações da aplicação, ou criar uma aplicação nova
# do tipo "Pagamentos online" com Checkout Pro + Assinaturas marcados).
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""

# URL pública da SUA API (não do app!) que recebe o dono de volta depois de
# autorizar — precisa ser https:// em produção e estar cadastrada como
# "Redirect URI" nas configurações da sua aplicação no painel do Mercado
# Pago. Repare no "/api" antes de "/saloes" (prefixo global da API, ver
# main.ts): "<url pública da API>/api/saloes/mercadopago/callback"
# (ex: "https://api.suaempresa.com/api/saloes/mercadopago/callback").
MERCADOPAGO_OAUTH_REDIRECT_URI=""

# Só usado quando o dono conecta o Mercado Pago pela versão WEB do app (Expo
# Web — ver apps/mobile/Dockerfile.web), não pelo app instalado. Depois de
# autorizar, o Mercado Pago volta pro MERCADOPAGO_OAUTH_REDIRECT_URI de cima
# (isso nunca muda), e a API então manda o navegador de volta pra essa(s)
# origem(ns) — por isso elas precisam estar aqui. NÃO é cadastrado no painel
# do Mercado Pago, é só uma lista de permissão (allowlist) nossa, pra ninguém
# conseguir montar esse link apontando pra um domínio de phishing (ver
# SaloesMercadoPagoService.validarOrigemWeb).
#
# Lista separada por vírgula, cada item só protocolo+domínio (sem caminho,
# sem barra no final) — ex: a URL pública de onde a versão web do app
# (apps/mobile/Dockerfile.web) está publicada no EasyPanel, e o endereço que
# aparece no navegador ao rodar `pnpm --filter @salao-saas/mobile web`
# localmente (geralmente http://localhost:8081).
MERCADOPAGO_WEB_ORIGENS_PERMITIDAS="https://app.bellaone.store,http://localhost:8081"
