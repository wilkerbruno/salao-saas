# Pra testar no celular físico com Expo Go, use a URL PÚBLICA da API já
# publicada no EasyPanel (ex: https://sua-api.dominio.com/api) — veja
# docs/DEPLOY_EASYPANEL.md. "localhost" só funciona rodando no navegador/
# emulador na mesma máquina da API.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Preencha com o "id" retornado por POST /api/auth/registrar-salao
EXPO_PUBLIC_SALAO_ID=
